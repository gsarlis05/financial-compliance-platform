# Local development configuration. Create .env with `make dev-env`, which generates random secrets.
# Placeholder values only; never put real credentials here.
DJANGO_SECRET_KEY=generated-by-make-dev-env
POSTGRES_DB=fcp
# Container superuser: used only to initialise the cluster, never by the application.
POSTGRES_USER=fcp
POSTGRES_PASSWORD=generated-by-make-dev-env
# Schema owner (migrations, tests) and runtime role; neither can bypass row-level security.
POSTGRES_OWNER_USER=fcp_owner
POSTGRES_OWNER_PASSWORD=generated-by-make-dev-env
POSTGRES_APP_USER=fcp_app
POSTGRES_APP_PASSWORD=generated-by-make-dev-env
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=generated-by-make-dev-env
OIDC_ISSUER=http://localhost:8080/realms/fcp-dev
OIDC_CLIENT_ID=fcp-backend
OIDC_CLIENT_SECRET=generated-by-make-dev-env
S3_ENDPOINT=http://127.0.0.1:8333
S3_ACCESS_KEY=generated-by-make-dev-env
S3_SECRET_KEY=generated-by-make-dev-env
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
# The SPA dev server (5173) proxies /auth and /api to Django, so sign-in returns to the SPA.
OIDC_REDIRECT_URI=http://localhost:5173/auth/callback
CSRF_TRUSTED_ORIGINS=http://localhost:5173
